# Run npm run env:init to generate .env with random passwords.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=app_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
BACKEND_DB_PASSWORD=replace_me
AGENT_DB_PASSWORD=replace_me
ADMIN_DATABASE_URL=postgresql://postgres:replace_me@127.0.0.1:5432/app_dev
BACKEND_DATABASE_URL=postgresql://app_backend:replace_me@127.0.0.1:5432/app_dev
AGENT_DATABASE_URL=postgresql://app_agent:replace_me@127.0.0.1:5432/app_dev
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
# Generated once by env:init. Keep these keys with your database backups.
DATA_ENCRYPTION_KEY=replace_with_base64_32_byte_key
EMAIL_LOOKUP_KEY=replace_with_another_base64_32_byte_key
